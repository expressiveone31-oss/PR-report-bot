TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VK_ACCESS_TOKEN=your_vk_service_token
TELEMETR_TOKEN=your_telemetr_token
HIKERAPI_TOKEN=your_hikerapi_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Google Sheets — сервисный аккаунт (для /update ссылок Google Sheets).
# Локально — путь к скачанному JSON-ключу:
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service_account.json
# В Railway — весь JSON одной переменной (multiline env value):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
